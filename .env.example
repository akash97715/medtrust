# ── Backend (Railway) ─────────────────────────────────────────
# Railway auto-sets DATABASE_URL when you add a Postgres service.
# It also sets PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD individually.
DATABASE_URL=

# Only needed for local dev if not using DATABASE_URL:
PGHOST=localhost
PGPORT=5432
PGDATABASE=medtrust_healthcare
PGUSER=postgres
PGPASSWORD=

# Comma-separated extra CORS origins (add your Vercel URL here in Railway)
# e.g. https://medtrusthealthcare.vercel.app,https://medtrust.space
ALLOWED_ORIGINS_EXTRA=

# ── Frontend (Vercel) ──────────────────────────────────────────
# Set this in Vercel dashboard → Settings → Environment Variables
NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
